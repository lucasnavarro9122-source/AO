diff --git a/Assets/AOMigrator/Runtime/Shared/AODeathDropRulesV900.cs b/Assets/AOMigrator/Runtime/Shared/AODeathDropRulesV900.cs
new file mode 100644
index 0000000..65626e9
--- /dev/null
+++ b/Assets/AOMigrator/Runtime/Shared/AODeathDropRulesV900.cs
@@ -0,0 +1,83 @@
+using System;
+using System.Collections.Generic;
+
+// Pérdida al morir como AO20 (Modulo_UsUaRiOs.UserDie -> InvUsuario.TirarTodosLosItems).
+// C# puro, sin UnityEngine: lo usan el juego (offline) y el servidor cooperativo (online).
+// Fuente y detalle: docs/claude/contenido/perdida_al_morir_original.md
+public static class AODeathDropRulesV900
+{
+    public const int WalletPerLevel = 1000; // OroPorNivelBilletera: el oro hasta 1000 x nivel no se cae
+    public const int NewbieMaxLevel = 12;   // LimiteNewbie: hasta este nivel no se caen los objetos Newbie=1
+    public const int MaxPile = 10000;       // MaxInventoryObjs: tope por pila en un tile
+    public const int SearchRadius = 15;     // Tilelibre busca hasta 15 tiles alrededor
+    public const int TriggerArena = 6;      // ZONAPELEA: ahí no se cae nada
+    public const int ObjKey = 9, ObjBoat = 31, ObjMount = 44;
+
+    public struct Drop
+    {
+        public int item, amount, x, y;
+        public bool gold;
+        public bool Placed => x != 0 || y != 0; // sin lugar: el objeto se pierde ("nada de mochilas gratis")
+    }
+
+    public static long GoldToDrop(long gold, int level) =>
+        Math.Max(0L, gold - (long)WalletPerLevel * Math.Max(1, level));
+
+    // ItemSeCae + la protección newbie de TirarTodosLosItems.
+    public static bool ItemFalls(int objType, bool noDrop, bool cantThrow, bool destroy, bool untransferable, bool newbie, int level)
+    {
+        if (noDrop || cantThrow || destroy || untransferable) return false;
+        if (objType == ObjKey || objType == ObjBoat || objType == ObjMount) return false;
+        return !(newbie && level <= NewbieMaxLevel);
+    }
+
+    // canDrop(x, y): tile de tierra libre (sin bloqueo, salida, NPC ni jugador).
+    // floorAt(x, y): objeto que ya hay en el piso (item 0 si no hay).
+    // Primero el oro (en pilas de hasta MaxPile), después cada pila del inventario entera.
+    // El oro que no encuentra lugar se queda con el jugador (goldKept); un objeto sin lugar se pierde.
+    public static List<Drop> Plan(int cx, int cy, long goldToDrop, int goldItem, IList<(int item, int amount)> stacks,
+        Func<int, int, bool> canDrop, Func<int, int, (int item, int amount)> floorAt, out long goldKept)
+    {
+        var drops = new List<Drop>();
+        var placed = new Dictionary<long, (int item, int amount)>();
+        goldKept = 0;
+        long remaining = Math.Max(0L, goldToDrop);
+        while (remaining > 0)
+        {
+            int pile = (int)Math.Min(remaining, MaxPile);
+            if (!FindTile(cx, cy, goldItem, pile, canDrop, floorAt, placed, out int gx, out int gy)) { goldKept = remaining; break; }
+            drops.Add(new Drop { item = goldItem, amount = pile, x = gx, y = gy, gold = true });
+            remaining -= pile;
+        }
+        for (int i = 0; i < stacks.Count; i++)
+        {
+            var (item, amount) = stacks[i];
+            if (item <= 0 || amount <= 0) continue;
+            FindTile(cx, cy, item, amount, canDrop, floorAt, placed, out int x, out int y);
+            drops.Add(new Drop { item = item, amount = amount, x = x, y = y });
+        }
+        return drops;
+    }
+
+    // Tilelibre: cuadrados de radio 0 a 15, fila por fila desde arriba a la izquierda.
+    // El tile del muerto está ocupado por él. Un objeto por tile; el mismo objeto se apila hasta MaxPile.
+    static bool FindTile(int cx, int cy, int item, int amount, Func<int, int, bool> canDrop,
+        Func<int, int, (int item, int amount)> floorAt, Dictionary<long, (int item, int amount)> placed, out int fx, out int fy)
+    {
+        for (int r = 0; r <= SearchRadius; r++)
+            for (int y = cy - r; y <= cy + r; y++)
+                for (int x = cx - r; x <= cx + r; x++)
+                {
+                    if (Math.Max(Math.Abs(x - cx), Math.Abs(y - cy)) != r || (x == cx && y == cy)) continue;
+                    if (!canDrop(x, y)) continue;
+                    long key = (long)y * 100000 + x;
+                    var here = placed.TryGetValue(key, out var p) ? p : floorAt(x, y);
+                    if (here.item != 0 && (here.item != item || here.amount + amount > MaxPile)) continue;
+                    placed[key] = (item, (here.item == item ? here.amount : 0) + amount);
+                    fx = x; fy = y;
+                    return true;
+                }
+        fx = 0; fy = 0;
+        return false;
+    }
+}
