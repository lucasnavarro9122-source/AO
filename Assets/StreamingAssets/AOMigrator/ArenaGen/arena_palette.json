{
  "version": 2,
  "autor": "Arte y Animación",
  "fuente": "docs/claude/demo/arte.md (GRH originales sacados de los 842 mapas)",
  "uso": "Paleta visual de AOArenaGen. Las claves de 'kinds' son el enum AOArenaGen.Kind (Pillar, Rock, Wall, Tree, Pool, Deco). El cliente dibuja grh[variant % count]. Solo 'densidad' entra en el generador (Programación la copia como constante, G-09).",
  "reglas": {
    "piso4x4": "grh = base + (y % 4) * 4 + (x % 4), con x,y del mapa (1..100), igual que el original",
    "piso3x3": "grh = base + (y % 3) * 3 + (x % 3)",
    "anclaje": "sprite centrado en X sobre la celda (o sobre el bloque 2x2), apoyado abajo, como los objetos del mapa",
    "porCelda": "muro y L: un tile de 32x32 por celda bloqueada",
    "agua": "Water sin costa: piso4x4 del set de agua (el servidor lo reconoce por HayAgua)",
    "deco": "capa 2, caminable, sin bloqueo",
    "formas": "Pillar y Tree: 1 sprite por celda (1x1). Rock: 1 sprite centrado sobre el bloque 2x2. Wall (recta o L): 1 tile de 32x32 por celda. Pool: set de agua 4x4 sin costa. Deco: sprite en capa 2, caminable."
  },
